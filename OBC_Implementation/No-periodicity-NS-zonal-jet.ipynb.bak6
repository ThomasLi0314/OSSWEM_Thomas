   "source": [
    "# Original Run with Prescribed West Boundary + Orlanski East Boundary"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d6f9c3cb",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1300x800 with 8 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "x_km  = M.xh1 / 1e3\n",
    "y_km  = M.yh1 / 1e3\n",
    "dx_km = M.dx / 1e3\n",
    "# [2L] eta_k = -D + sum_{l>=k} h_l ; the displacement from rest adds back sum_{l<k} Ho[l].\n",
    "# [2L] k = 0 is the FREE SURFACE -- the old `h[0] - D` only equals it when nk == 1.\n",
    "eta_init = [ic[2][k:].sum(axis=0)      - M.D + M.Ho[:k].sum() for k in range(nk)]      # [2L]\n",
    "eta_targ = [M.h_target[k:].sum(axis=0) - M.D + M.Ho[:k].sum() for k in range(nk)]      # [2L]\n",
    "xW0 = x_km[west_cols.min()] - dx_km / 2     # prescribed-W band edges [km]\n",
    "xW1 = x_km[west_cols.max()] + dx_km / 2\n",
    "xE  = x_km[b_obc]                         # Orlanski-E column [km]\n",
    "\n",
    "def _mark(ax):\n",
    "    ax.axvspan(xW0, xW1, color='tab:blue', alpha=0.25, label='prescribed W boundary')\n",
    "    ax.axvline(xE, color='tab:red', lw=2, label='Orlanski E OBC')\n",
    "\n",
    "panels = [(r'sponge rate $(u,v)$ [s$^{-1}$]', M.u_relax[0]),\n",
    "          (r'sponge rate $h$ [s$^{-1}$]',     M.h_relax[0])]\n",
    "for k in range(nk):                                                                   # [2L]\n",
    "    lbl = 'free surface' if k == 0 else 'interface'\n",
    "    panels += [(rf'balanced target $\\eta_{k}$ ({lbl}) [m]',   eta_targ[k]),\n",
    "               (rf'initial $\\eta_{k}(t{{=}}0)$ ({lbl}) [m]',  eta_init[k])]\n",
    "\n",
    "nrow = int(np.ceil(len(panels) / 2))                                                  # [2L]\n",
    "fig, ax = plt.subplots(nrow, 2, figsize=(13, 4 * nrow), squeeze=False)\n",
    "for a, (title, fld) in zip(ax.ravel(), panels):\n",
    "    p = a.pcolormesh(x_km, y_km, fld); fig.colorbar(p, ax=a); a.set_title(title, fontsize=10)\n",
    "    _mark(a); a.set_xlabel('x [km]'); a.set_ylabel('y [km]')\n",
    "for a in ax.ravel()[len(panels):]:\n",
    "    a.axis('off')\n",
    "ax[0,0].legend(loc='upper right', fontsize=8)\n",
    "fig.suptitle(f'[CFG] {CONFIG} (nk={nk})   |   E Orlanski at i={b_obc} (x~{xE:.0f} km)')\n",
    "fig.tight_layout()\n"
   ]
  },
