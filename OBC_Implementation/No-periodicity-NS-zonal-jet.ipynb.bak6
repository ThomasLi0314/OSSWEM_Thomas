     "text": [
      "[OBC] 30 boundary columns i = [np.int64(0), np.int64(1), np.int64(2), np.int64(3), np.int64(4), np.int64(5), np.int64(6), np.int64(7), np.int64(8), np.int64(9), np.int64(10), np.int64(11), np.int64(12), np.int64(13), np.int64(14), np.int64(15), np.int64(16), np.int64(17), np.int64(18), np.int64(19), np.int64(20), np.int64(21), np.int64(22), np.int64(23), np.int64(24), np.int64(25), np.int64(26), np.int64(27), np.int64(28), np.int64(29)],\n",
      "[2L] cg  = 8.000 m/s   Courant dt*cg/dx  = 0.160\n",
      "[2L] cg1 = 3.464 m/s   Courant dt*cg1/dx = 0.069\n",
      "[2L] exact modes: c0 = 8.842 m/s (Courant 0.177)   c1 = 3.134 m/s (Courant 0.063)\n",
      "[2L] BC-store RAM estimate: ~13.0 GB for (h,u,v)_bc_all over 50000 steps (+ probe & centre line) -- mind the pagefile\n"
     ]
    }
   ],
   "source": [
    "assert Lw_uv == Lw_h, \"The SPonge Layer width of u,v is different from h\"\n",
    "n_bc = int(Lw_uv / dx)\n",
    "i_edge  = np.where(M.xh1 < Lw_uv)[0].max()   # [EXT] ratio_temp/width were removed from the setup cell\n",
    "west_cols = np.arange(i_edge - n_bc + 1, i_edge + 1)\n",
    "print(f'[OBC] {n_bc} boundary columns i = {list(west_cols)},'\n",
    ")\n",
    "ic = (M.u.copy(), M.v.copy(), M.h.copy(), M.time, M.iter)\n",
    "\n",
    "# --------------- [2L] CFL + memory safety check (valid for any layer count) ---------------\n",
    "dt_cfg = run_params[0]\n",
    "print(f\"[2L] cg  = {M.cg:.3f} m/s   Courant dt*cg/dx  = {dt_cfg*M.cg/M.dx:.3f}\")\n",
    "if M.cg1 is not None:                                       # only defined at nk == 2\n",
    "    print(f\"[2L] cg1 = {M.cg1:.3f} m/s   Courant dt*cg1/dx = {dt_cfg*M.cg1/M.dx:.3f}\")\n",
    "# [2L] EXACT linear mode speeds. The cg/cg1 formulas above assume g' << g0; at g'/g0 = 0.75\n",
    "# [2L] they are ~10% off. Linearised: d2h/dt2 = B d2h/dx2 with\n",
    "# [2L]     B[k,l] = Ho[k] * sum_{m <= min(k,l)} g[m]     and   c^2 = eig(B).\n",
    "# [2L] At nk = 1 this returns cg exactly, so the check runs unconditionally.\n",
    "Bmat    = np.array([[M.Ho[k] * M.g[:min(k, l) + 1].sum() for l in range(nk)] for k in range(nk)])\n",
    "c_modes = np.sqrt(np.sort(np.linalg.eigvals(Bmat).real)[::-1])\n",
    "print('[2L] exact modes: ' + '   '.join(\n",
    "    f'c{i} = {c:.3f} m/s (Courant {dt_cfg*c/M.dx:.3f})' for i, c in enumerate(c_modes)))\n",
    "# [2L] the per-step west-boundary stores dominate RAM and scale as nsteps * nk * n_bc\n",
    "nsteps_tot = int(run_params[1] * run_params[2])\n",
    "_gb = 3 * nsteps_tot * nk * M.nj * n_bc * 8 / 1e9\n",
    "print(f\"[2L] BC-store RAM estimate: ~{_gb:.1f} GB for (h,u,v)_bc_all over {nsteps_tot} steps \"\n",
    "      f\"(+ probe & centre line) -- mind the pagefile\")\n"
   ]
  },
